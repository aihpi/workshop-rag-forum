# Copy this file to .env and fill in your values. .env is gitignored.
#
# One OpenAI-compatible endpoint serves both embeddings and chat. Against a
# LiteLLM proxy, OPENAI_API_BASE is the proxy URL and the model names below are
# whatever deployments the proxy exposes.
OPENAI_API_KEY=your_key_here
OPENAI_API_BASE=http://localhost:4000/v1

# Embedding model. minilm-embedding is small/fast and used for the 260615-turbovec meeting.
# Swappable: qwen3-vl-embedding-8b, octen-embedding-8b
OPENAI_EMBEDDING_MODEL=minilm-embedding

# Chat model for the generation stage. No default is assumed: leave it unset and
# the pipeline runs retrieval-only rather than calling a model you do not host.
OPENAI_CHAT_MODEL=

# Optional: embedding dimensionality. If unset, it is inferred from the API response.
# OPENAI_EMBEDDING_DIM=384

# --- Optional tuning -------------------------------------------------------
# Chunking (the embedding endpoint caps each input at 256 tokens).
# CHUNK_WORDS=90
# CHUNK_OVERLAP_WORDS=20
# MAX_CHARS=450
# EMBED_BATCH=32

# Generation.
# RAG_TEMPERATURE=0.0        # 0 keeps bias runs reproducible
# RAG_MAX_TOKENS=512
# RAG_TIMEOUT=60
# RAG_MAX_RETRIES=5

# Where corpora, indexes and results are written (default: <repo>/data).
# RAG_DATA_DIR=/path/to/data
